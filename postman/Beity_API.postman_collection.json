            "body": {
              "mode": "raw",
              "raw": "{\n  \"language\": \"ar\",\n  \"lastDestination\": \"north-coast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('beity_prefs is HttpOnly, Secure and SameSite=Lax', function () {",
                  "  const cookie = pm.response.headers.get('Set-Cookie');",
                  "  pm.expect(cookie).to.include('beity_prefs=');",
                  "  pm.expect(cookie).to.include('HttpOnly');",
