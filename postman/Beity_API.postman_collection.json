{
  "info": {
    "name": "Beity API – Milestone 4",
    "description": "Beity backend: login, Create Listing and Book a Stay.\n\nBefore running:\n1. Start the server (npm run seed, then npm start).\n2. In Postman settings, turn OFF \"SSL certificate verification\" (the local certificate is self-signed).\n3. Run the folders in order (Collection Runner, or one by one).\n\nPostman keeps the cookies for you. After every login the CSRF token is saved in {{csrfToken}} and sent in the X-CSRF-Token header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:3443/api/v1"
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "guestEmail",
      "value": ""
    },
    {
      "key": "guestPassword",
      "value": "Sahel-Summer-2027"
    },
    {
      "key": "hostEmail",
      "value": "host@beity.test"
    },
    {
      "key": "hostPassword",
      "value": "Host-Pass-2026"
    },
    {
      "key": "adminEmail",
      "value": "admin@beity.test"
    },
    {
      "key": "adminPassword",
      "value": "Admin-Pass-2026"
    },
    {
      "key": "listingId",
      "value": ""
    },
    {
      "key": "licenseNumber",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "checkIn",
      "value": ""
    },
    {
      "key": "checkOut",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sign up and log in",
      "item": [
        {
          "name": "Sign up a new guest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Mariam Hassan\",\n  \"email\": \"{{guestEmail}}\",\n  \"password\": \"{{guestPassword}}\",\n  \"phone\": \"+201112223334\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// a new email every run, so the request can be sent many times",
                  "pm.collectionVariables.set('guestEmail', 'guest' + Date.now() + '@beity.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('New accounts are guests', function () {",
                  "  pm.expect(pm.response.json().data.role).to.equal('guest');",
                  "});",
                  "pm.test('Session cookie is HttpOnly, Secure and SameSite=Strict', function () {",
                  "  const cookie = pm.response.headers.get('Set-Cookie');",
                  "  pm.expect(cookie).to.include('HttpOnly');",
                  "  pm.expect(cookie).to.include('Secure');",
                  "  pm.expect(cookie).to.include('SameSite=Strict');",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.csrfToken) {",
                  "  pm.collectionVariables.set('csrfToken', json.data.csrfToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I (phone is decrypted)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Phone number is decrypted', function () {",
                  "  pm.expect(pm.response.json().data.phone).to.equal('+201112223334');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Weak password is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"email\": \"weak@beity.test\",\n  \"password\": \"12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong password gets 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
