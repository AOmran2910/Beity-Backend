    {
      "name": "3. Book a Stay (use case 2)",
      "item": [
        {
          "name": "Log in as the guest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{guestEmail}}\",\n  \"password\": \"{{guestPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Role is guest', function () {",
                  "  pm.expect(pm.response.json().data.role).to.equal('guest');",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.csrfToken) {",
                  "  pm.collectionVariables.set('csrfToken', json.data.csrfToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Check availability and price",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}/availability?checkIn={{checkIn}}&checkOut={{checkOut}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "listings",
                "{{listingId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "checkIn",
                  "value": "{{checkIn}}"
                },
                {
                  "key": "checkOut",
                  "value": "{{checkOut}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// a random 5-night stay in summer 2027",
                  "const start = new Date(Date.UTC(2027, 5, 1 + Math.floor(Math.random() * 100)));",
                  "const end = new Date(start.getTime() + 5 * 24 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set('checkIn', start.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('checkOut', end.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Free, 5 nights x 3,200 = 16,000 EGP', function () {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.available).to.equal(true);",
                  "  pm.expect(data.totalPrice).to.equal(16000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Book the stay (price sent is ignored)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"guests\": 3,\n  \"totalPrice\": 1,\n  \"messageToHost\": \"We are a family of three.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Pending, and the server worked out the price', function () {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.status).to.equal('pending');",
                  "  pm.expect(data.totalPrice).to.equal(16000);",
                  "});",
                  "pm.collectionVariables.set('bookingId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Book the same nights again (no double booking)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
