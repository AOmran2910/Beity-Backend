# Copy this file to .env and put your own values in it.
# Never upload the real .env file to GitHub.

HTTPS_PORT=3443
HTTP_PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=beity_app
DB_PASSWORD=change-this-password
DB_NAME=beity

# Key used to encrypt phone numbers and home addresses (64 hex characters).
# Make your own with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Set to true only when the app runs behind a cloud host that adds HTTPS (like Render or Railway)
TRUST_PROXY=false
